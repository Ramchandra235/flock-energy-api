# Server Configuration
PORT=3000
NODE_ENV=development

# Upstream Urja Meter Ops Legacy Portal Credentials
URJA_BASE_URL=https://urja-ops.flockenergy.tech
URJA_USERNAME=operator@urja.local
URJA_PASSWORD=urja-ops-2026

# Upstream Request Timeout (milliseconds)
UPSTREAM_TIMEOUT_MS=10000

# Optional API Access Control for this wrapper (Leave empty to disable in local dev)
# If set, downstream consumers must provide this via 'x-api-key' header
API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
