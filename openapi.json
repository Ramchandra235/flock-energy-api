{
  "openapi": "3.0.3",
  "info": {
    "title": "Flock Energy - Urja Meter Ops API Wrapper",
    "version": "1.0.0",
    "description": "A production-minded, standardized REST API wrapper around the legacy Urja Meter Ops web portal (https://urja-ops.flockenergy.tech). Provides programmatic access to smart-meter listings, individual meter nameplates and geolocations, consumption histories, and electricity distribution network hierarchies.\n",
    "contact": {
      "name": "Flock Energy Engineering Team",
      "url": "https://flockenergy.tech"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health check",
        "description": "Returns service uptime, timestamp, and upstream portal connection status.",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy and operational.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "service": "flock-energy-api",
                  "version": "1.0.0",
                  "uptime": 120,
                  "timestamp": "2026-10-27T01:30:00.000Z",
                  "upstream": {
                    "url": "https://urja-ops.flockenergy.tech",
                    "authenticated": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "summary": "List smart meters",
        "description": "Retrieves a paginated list of smart meters. Supports searching by meter ID or serial number.",
        "tags": [
          "Meters"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search term matching meter ID or serial number prefix/value.",
            "schema": {
              "type": "string",
              "default": ""
            },
            "example": "J100000"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number for pagination (starts at 1).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved meters list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterListResponse"
                },
                "example": {
                  "status": "success",
                  "data": [
                    {
                      "meter_id": "J100000",
                      "serial_number": "SE33962",
                      "make": "HPL",
                      "phase_type": "single",
                      "status": "DECOMMISSIONED",
                      "dt_code": "DT-001"
                    },
                    {
                      "meter_id": "J100001",
                      "serial_number": "GE84132",
                      "make": "L&T",
                      "phase_type": "single",
                      "status": "INSTALLED",
                      "dt_code": "DT-002"
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "page_size": 20,
                    "total": 403,
                    "total_pages": 21
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "502": {
            "$ref": "#/components/responses/BadGatewayError"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeoutError"
          }
        }
      }
    },
    "/api/v1/meters/{id}": {
      "get": {
        "summary": "Retrieve a specific meter",
        "description": "Fetches unified meter details including nameplate parameters, installation status, hierarchical path, and GPS coordinates.",
        "tags": [
          "Meters"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the meter (e.g. J100000).",
            "schema": {
              "type": "string"
            },
            "example": "J100000"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved meter details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetailResponse"
                },
                "example": {
                  "status": "success",
                  "data": {
                    "meter_id": "J100000",
                    "serial_number": "SE33962",
                    "make": "HPL",
                    "phase_type": "single",
                    "status": "DECOMMISSIONED",
                    "installation_type": "Whole Current",
                    "location": {
                      "latitude": 26.938961,
                      "longitude": 75.830957
                    },
                    "hierarchy": {
                      "zone": {
                        "name": "Jaipur Zone 1",
                        "code": "Z-01"
                      },
                      "circle": {
                        "name": "Circle 1",
                        "code": "C-01"
                      },
                      "division": {
                        "name": "Division 1",
                        "code": "D-01"
                      },
                      "subdivision": {
                        "name": "Subdivision 1",
                        "code": "SD-01"
                      },
                      "substation": {
                        "name": "Substation 1",
                        "code": "SS-01"
                      },
                      "feeder": {
                        "name": "Feeder 1",
                        "code": "F-001"
                      },
                      "dt": {
                        "name": "Malviya Nagar DT 1",
                        "code": "DT-001"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "502": {
            "$ref": "#/components/responses/BadGatewayError"
          }
        }
      }
    },
    "/api/v1/meters/{id}/consumption": {
      "get": {
        "summary": "Retrieve meter consumption history",
        "description": "Returns historical 30-minute interval readings (kWh, kVAh, and Phase voltage) for a smart meter.",
        "tags": [
          "Meters"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the meter.",
            "schema": {
              "type": "string"
            },
            "example": "J100000"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved consumption readings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterConsumptionResponse"
                },
                "example": {
                  "status": "success",
                  "data": {
                    "meter_id": "J100000",
                    "readings_count": 337,
                    "readings": [
                      {
                        "timestamp": "2026-06-23T23:30:00Z",
                        "raw_timestamp": "23/06/2026 23:30",
                        "kwh": 48438.74,
                        "kvah": 52313.84,
                        "voltage_r": 226
                      },
                      {
                        "timestamp": "2026-06-24T00:00:00Z",
                        "raw_timestamp": "24/06/2026 00:00",
                        "kwh": 48439.16,
                        "kvah": 52314.29,
                        "voltage_r": 229
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/api/v1/hierarchy": {
      "get": {
        "summary": "Retrieve network distribution hierarchy",
        "description": "Reconstructs the distribution network hierarchy tree from Zones down to Distribution Transformers and meters. Results are cached in memory.",
        "tags": [
          "Network"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "refresh",
            "in": "query",
            "required": false,
            "description": "Force refresh cache from upstream portal (true/false).",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved network hierarchy tree.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HierarchyResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "502": {
            "$ref": "#/components/responses/BadGatewayError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Optional API key for downstream access control (active when configured in wrapper env)."
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Bad Request - Query or path parameter validation failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "status": "error",
              "error": {
                "code": "VALIDATION_ERROR",
                "message": "Request validation failed",
                "details": [
                  {
                    "field": "page",
                    "message": "Number must be greater than or equal to 1"
                  }
                ]
              }
            }
          }
        }
      },
      "NotFoundError": {
        "description": "Not Found - Specified meter was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "status": "error",
              "error": {
                "code": "METER_NOT_FOUND",
                "message": "Meter with ID 'NONEXISTENT' not found"
              }
            }
          }
        }
      },
      "UnauthorizedError": {
        "description": "Unauthorized - Missing or invalid API key.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "status": "error",
              "error": {
                "code": "UNAUTHORIZED",
                "message": "Unauthorized: Missing or invalid API key in x-api-key header"
              }
            }
          }
        }
      },
      "BadGatewayError": {
        "description": "Bad Gateway - Upstream Urja Ops portal error or unreachable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "status": "error",
              "error": {
                "code": "BAD_GATEWAY",
                "message": "Unable to connect to upstream Urja Ops portal"
              }
            }
          }
        }
      },
      "GatewayTimeoutError": {
        "description": "Gateway Timeout - Upstream Urja Ops portal did not respond in time.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "status": "error",
              "error": {
                "code": "GATEWAY_TIMEOUT",
                "message": "Upstream Urja Ops portal timed out while processing request"
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "status",
          "error"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "example": "Request validation failed"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "service",
          "version",
          "uptime",
          "timestamp",
          "upstream"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "flock-energy-api"
          },
          "version": {
            "type": "string",
            "example": "1.0.0"
          },
          "uptime": {
            "type": "integer",
            "example": 45
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "upstream": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "authenticated": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "MeterSummary": {
        "type": "object",
        "required": [
          "meter_id",
          "serial_number",
          "make",
          "phase_type",
          "status",
          "dt_code"
        ],
        "properties": {
          "meter_id": {
            "type": "string",
            "example": "J100000"
          },
          "serial_number": {
            "type": "string",
            "example": "SE33962"
          },
          "make": {
            "type": "string",
            "example": "HPL"
          },
          "phase_type": {
            "type": "string",
            "enum": [
              "single",
              "three",
              null
            ],
            "example": "single"
          },
          "status": {
            "type": "string",
            "example": "DECOMMISSIONED"
          },
          "dt_code": {
            "type": "string",
            "example": "DT-001"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "page",
          "page_size",
          "total",
          "total_pages"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "page_size": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer",
            "example": 403
          },
          "total_pages": {
            "type": "integer",
            "example": 21
          }
        }
      },
      "MeterListResponse": {
        "type": "object",
        "required": [
          "status",
          "data",
          "pagination"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeterSummary"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "NamedEntity": {
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Jaipur Zone 1"
          },
          "code": {
            "type": "string",
            "nullable": true,
            "example": "Z-01"
          }
        }
      },
      "MeterDetail": {
        "type": "object",
        "required": [
          "meter_id",
          "serial_number",
          "make",
          "phase_type",
          "status",
          "installation_type",
          "location",
          "hierarchy"
        ],
        "properties": {
          "meter_id": {
            "type": "string",
            "example": "J100000"
          },
          "serial_number": {
            "type": "string",
            "nullable": true,
            "example": "SE33962"
          },
          "make": {
            "type": "string",
            "nullable": true,
            "example": "HPL"
          },
          "phase_type": {
            "type": "string",
            "nullable": true,
            "example": "single"
          },
          "status": {
            "type": "string",
            "example": "DECOMMISSIONED"
          },
          "installation_type": {
            "type": "string",
            "nullable": true,
            "example": "Whole Current"
          },
          "location": {
            "type": "object",
            "nullable": true,
            "properties": {
              "latitude": {
                "type": "number",
                "example": 26.938961
              },
              "longitude": {
                "type": "number",
                "example": 75.830957
              }
            }
          },
          "hierarchy": {
            "type": "object",
            "properties": {
              "zone": {
                "$ref": "#/components/schemas/NamedEntity"
              },
              "circle": {
                "$ref": "#/components/schemas/NamedEntity"
              },
              "division": {
                "$ref": "#/components/schemas/NamedEntity"
              },
              "subdivision": {
                "$ref": "#/components/schemas/NamedEntity"
              },
              "substation": {
                "$ref": "#/components/schemas/NamedEntity"
              },
              "feeder": {
                "$ref": "#/components/schemas/NamedEntity"
              },
              "dt": {
                "$ref": "#/components/schemas/NamedEntity"
              }
            }
          }
        }
      },
      "MeterDetailResponse": {
        "type": "object",
        "required": [
          "status",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/MeterDetail"
          }
        }
      },
      "ConsumptionReading": {
        "type": "object",
        "required": [
          "timestamp",
          "raw_timestamp",
          "kwh",
          "kvah",
          "voltage_r"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "example": "2026-06-23T23:30:00Z"
          },
          "raw_timestamp": {
            "type": "string",
            "example": "23/06/2026 23:30"
          },
          "kwh": {
            "type": "number",
            "nullable": true,
            "example": 48438.74
          },
          "kvah": {
            "type": "number",
            "nullable": true,
            "example": 52313.84
          },
          "voltage_r": {
            "type": "number",
            "nullable": true,
            "example": 226
          }
        }
      },
      "MeterConsumptionResponse": {
        "type": "object",
        "required": [
          "status",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "data": {
            "type": "object",
            "required": [
              "meter_id",
              "readings_count",
              "readings"
            ],
            "properties": {
              "meter_id": {
                "type": "string",
                "example": "J100000"
              },
              "readings_count": {
                "type": "integer",
                "example": 337
              },
              "readings": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ConsumptionReading"
                }
              }
            }
          }
        }
      },
      "HierarchyResponse": {
        "type": "object",
        "required": [
          "status",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "data": {
            "type": "object",
            "required": [
              "total_meters_indexed",
              "total_zones",
              "zones"
            ],
            "properties": {
              "total_meters_indexed": {
                "type": "integer",
                "example": 403
              },
              "total_zones": {
                "type": "integer",
                "example": 4
              },
              "zones": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}